# Auto detect text files and perform LF normalization
* text=auto eol=lf

# Explicitly ensure source code uses LF line endings
*.js text eol=lf
*.css text eol=lf
*.html text eol=lf
*.json text eol=lf
*.md text eol=lf
*.py text eol=lf
*.sh text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.svg text eol=lf
*.webmanifest text eol=lf

# Binary files
*.mp3 binary
*.wav binary
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.ico binary
*.ttf binary
