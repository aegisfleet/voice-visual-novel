{
  "$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "ignoreUnknown": false,
    "includes": [
      "assets/js/**/*.js",
      "eve/js/**/*.js",
      "eve/css/**/*.css",
      "eve/**/*.html",
      "box/js/**/*.js",
      "box/css/**/*.css",
      "box/**/*.html",
      "*.html",
      "*.json",
      "!package-lock.json"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100,
    "lineEnding": "lf"
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "complexity": {
        "noExcessiveCognitiveComplexity": {
          "level": "warn",
          "options": {
            "maxAllowedComplexity": 15
          }
        },
        "noImportantStyles": "off",
        "useArrowFunction": "off",
        "noUselessSwitchCase": "off",
        "noArguments": "off"
      },
      "suspicious": {
        "noDuplicateProperties": "warn",
        "noRedundantUseStrict": "off"
      },
      "a11y": {
        "noSvgWithoutTitle": "off",
        "useMediaCaption": "off"
      },
      "style": {
        "useNumberNamespace": "error",
        "noDescendingSpecificity": "off",
        "useTemplate": "off"
      }
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single"
    }
  }
}
